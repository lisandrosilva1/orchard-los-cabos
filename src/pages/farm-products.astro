---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Duo from '../components/Duo.astro';
import CtaBand from '../components/CtaBand.astro';
import { whatsappUrl } from '../data/site';

import heroImg from '../assets/images/carton-of-sage-eggs.jpg';
import trayImg from '../assets/images/egg-tray-in-hand.jpg';
import crateImg from '../assets/images/egg-crate-orchard-label.jpg';

const ask = (what: string) =>
  whatsappUrl(`Hi Orchard — I'd like to order ${what}. Could you send me current availability and pricing?`);

const products = [
  { id: 'farm-fresh-eggs', name: 'Farm-fresh eggs',
    lede: 'The everyday egg, collected by hand each morning.',
    body: 'Brown, cream and freckled tan shells from the laying flock, sorted and packed the same day they are collected. By the dozen in cartons, or by the tray for households and kitchens that go through a lot of them.',
    meta: ['Dozen or tray', 'Carton or wooden crate', 'Orchard packaging available'] },
  { id: 'coloured-eggs', name: 'Speciality coloured eggs',
    lede: 'Sage, powder blue and olive, from the araucanas.',
    body: 'The blue-greens come from specific birds and are laid in smaller numbers, so they move in and out of availability. Mixed trays — pale blue beside deep russet and cream — are the ones chefs ask for.',
    meta: ['Limited and seasonal', 'Mixed-colour trays', 'For plating and display'] },
  { id: 'whole-poultry', name: 'Whole poultry',
    lede: 'Whole birds, vacuum-sealed.',
    body: 'Broiler chickens and mature hens raised on the same farm and the same feed as the laying flock, processed and vacuum-sealed for the trip to your kitchen. Sizes vary by batch, so weight and availability are confirmed when you order.',
    meta: ['Vacuum-sealed', 'Broilers and mature hens', 'Confirmed per batch'] },
  { id: 'poultry-feed', name: 'Farm-milled poultry feed',
    lede: 'The same feed our own birds eat, in 25 kg sacks.',
    body: 'Formulated and pelleted on the farm from corn, wheat bran, soybean meal and scratch grains, with ginger, turmeric, garlic, onion and oregano. No added hormones, no artificial preservatives. Sold to smallholders and properties keeping their own birds.',
    meta: ['25 kg sacks', 'Pelletised', 'Delivery available'] },
  { id: 'composted-fertiliser', name: 'Composted chicken manure',
    lede: 'What the farm gives back to the soil.',
    body: 'Composted on site under controlled fermentation and bagged ready to use — a nitrogen-rich conditioner for vegetable beds, fruit trees and ornamentals. Sold by the bag with a minimum order.',
    meta: ['Bagged, ready to use', 'Minimum order applies', 'Composted on the farm'] },
];
---
<Base
  title="Farm Products — Eggs, Poultry & Feed | Orchard Los Cabos"
  description="Farm-fresh eggs, speciality coloured eggs, whole poultry, farm-milled feed and composted fertiliser, delivered across Los Cabos. Order on WhatsApp."
  breadcrumb={[{ name: 'Farm Products', href: '/farm-products/' }]}
  fabMessage="Hi Orchard — I'd like to order farm products."
>
  <PageHero src={heroImg}
    alt="A carton of Orchard eggs in soft sage, olive and cream, held up in the orchard."
    eyebrow="Farm products"
    title="What the farm has, week by week."
    lead="Eggs collected by hand, poultry raised on our own feed, and what comes with keeping a farm running. Availability shifts with the flock, so the fastest way to know what we have today is to ask.">
    <div class="btns">
      <a class="btn btn--solid" href={ask('farm products')} target="_blank" rel="noopener"
         data-evt="order_whatsapp_click" data-cta="products_header">Order on WhatsApp</a>
    </div>
  </PageHero>

  <section class="bay">
    <div class="shell">
      <ol class="plist">
        {products.map((p, i) => (
          <li class="prod rise" id={p.id} data-product-view data-product={p.id}>
            <div class="prod__side">
              <span class="prod__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h2>{p.name}</h2>
            </div>
            <div>
              <p class="prod__lede">{p.lede}</p>
              <p class="prod__text">{p.body}</p>
              <ul class="prod__meta">{p.meta.map((m) => <li>{m}</li>)}</ul>
              <a class="tlink prod__cta" href={ask(p.name.toLowerCase())} target="_blank" rel="noopener"
                 data-evt="order_whatsapp_click" data-cta="product_block" data-product={p.id}>
                Request availability
              </a>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Duo src={trayImg} ratio="1/1" tone="light"
       alt="A tray of Orchard eggs held in one hand, pale blue-green shells beside deep brown ones.">
    <span class="eyebrow">Ordering</span>
    <h2>How it works.</h2>
    <ol class="steps">
      <li><h3>Tell us what you need</h3><p>Message the farm on WhatsApp with what you are after and roughly how much.</p></li>
      <li><h3>We confirm what we have</h3><p>We reply with what is actually available that week and the current price. There is no fixed public price list, because the flock does not work that way.</p></li>
      <li><h3>Collect or have it delivered</h3><p>Pick up at the farm by appointment, or we deliver across Los Cabos. Regular customers usually move to a standing weekly order.</p></li>
    </ol>
    <div class="btns">
      <a class="btn btn--solid" href={ask('farm products')} target="_blank" rel="noopener"
         data-evt="order_whatsapp_click" data-cta="products_how">Start an order</a>
    </div>
  </Duo>

  <Duo src={crateImg} flip ratio="4/3"
       alt="A wooden Orchard egg crate tied with twine and tagged with the farm's label.">
    <span class="eyebrow">For kitchens</span>
    <h2>Buying for a hotel or restaurant?</h2>
    <div class="prose">
      <p>
        Standing weekly orders, speciality coloured eggs, packing under your own label and
        custom poultry programmes are handled separately from retail orders.
      </p>
    </div>
    <div class="btns">
      <a class="btn btn--line" href="/hospitality/" data-evt="hospitality_inquiry" data-cta="products_cross">
        See hospitality supply
      </a>
    </div>
  </Duo>

  <CtaBand location="products" />
</Base>

<style>
  .plist { list-style: none; margin: 0; padding: 0; }
  .prod { display: grid; gap: 1rem 3.5rem; padding-block: clamp(2.25rem, 1.5rem + 2.4vw, 3.75rem); border-top: 1px solid var(--line-d-soft); }
  .prod:first-child { border-top: 0; padding-top: 0; }
  .prod__n { display: block; font-family: var(--display); font-size: 0.8rem; letter-spacing: 0.26em; color: var(--ember); margin-bottom: 0.8rem; }
  .prod h2 { font-size: var(--t-h3); }
  .prod__lede { font-family: var(--display); font-size: clamp(1.3rem, 1.1rem + 0.9vw, 1.85rem); line-height: 1.26; max-width: 34ch; }
  .prod__text { margin-top: 1rem; color: var(--on-dark-soft); max-width: 58ch; }
  .prod__meta { list-style: none; padding: 0; margin: 1.5rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .prod__meta li {
    font-size: 0.64rem; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--on-dark-mute); border: 1px solid var(--line-d); padding: 0.5rem 0.9rem;
  }
  .prod__cta { margin-top: 1.9rem; }
  @media (min-width: 880px) { .prod { grid-template-columns: 19rem 1fr; } }

  .steps { list-style: none; margin: 2rem 0 0; padding: 0; counter-reset: s; display: grid; gap: 1.75rem; }
  .steps li { counter-increment: s; padding-left: 3rem; position: relative; }
  .steps li::before {
    content: counter(s, decimal-leading-zero); position: absolute; left: 0; top: 0.1rem;
    font-family: var(--display); font-size: 0.8rem; letter-spacing: 0.2em; color: var(--ember);
  }
  .steps h3 { font-family: var(--ui); font-weight: 500; font-size: 1rem; }
  .steps p { margin-top: 0.4rem; color: var(--on-light-soft); font-size: var(--t-small); }
</style>
