---
import Base from '../layouts/Base.astro';

---
<Base
  title="Page not found | Orchard Los Cabos"
  description="That page is not here. Find farm products, farm visits and hospitality supply from Orchard Los Cabos."
  noindex
>
  <section class="opener bay">
    <div class="shell">
      <span class="eyebrow">404</span>
      <h1>That page isn&rsquo;t here.</h1>
      <p class="lead opener__lead">
        It may have been retired when we rebuilt the site. Everything Orchard does is one of
        these four.
      </p>
    </div>
  </section>
  <section class="bay--tight">
    <div class="shell">
      <ul class="nf">
        <li><a href="/farm-products/">Farm Products</a><span>Eggs, poultry, feed and fertiliser</span></li>
        <li><a href="/farm-experience/">Farm Experience</a><span>Family and school visits</span></li>
        <li><a href="/hospitality/">Hospitality</a><span>Supply for hotels, restaurants and villas</span></li>
        <li><a href="/about/">About</a><span>The farm and why it exists</span></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .nf { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .nf li { display: grid; gap: 0.2rem; padding-block: 1.25rem; border-bottom: 1px solid var(--line); }
  .nf a { font-family: var(--display); font-size: 1.35rem; text-decoration: none; }
  .nf a:hover { color: var(--green); }
  .nf span { color: var(--ink-mute); font-size: var(--t-small); }
  @media (min-width: 700px) { .nf li { grid-template-columns: 18rem 1fr; align-items: baseline; } }
</style>
