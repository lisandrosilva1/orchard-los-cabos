---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import Reveal from '../components/Reveal.astro';
import { site, contact, socialLinks, maps, hours } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Path-relative OG image; defaults to the farm's own hero photograph. */
  ogImage?: string;
  noindex?: boolean;
  /** Breadcrumb trail, excluding Home. */
  breadcrumb?: { name: string; href: string }[];
  fabMessage?: string;
}

const {
  title,
  description,
  ogImage = '/social/orchard-og.jpg',
  noindex = false,
  breadcrumb = [],
  fabMessage = "Hi Orchard — I'd like to order farm products.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.origin).href;
const ogUrl = new URL(ogImage, site.origin).href;

/* JSON-LD. Only facts that were verified in the August 2026 content audit:
   no ratings, no reviews, no prices, no certifications. */
const graph: Record<string, unknown>[] = [
  {
    '@type': ['Organization', 'LocalBusiness'],
    '@id': `${site.origin}/#business`,
    name: site.name,
    url: `${site.origin}/`,
    description: site.description,
    telephone: contact.phoneE164,
    email: contact.email,
    image: ogUrl,
    address: {
      '@type': 'PostalAddress',
      streetAddress: contact.streetAddress,
      addressLocality: contact.city,
      addressRegion: contact.regionCode,
      postalCode: contact.postalCode,
      addressCountry: contact.countryCode,
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: maps.latitude,
      longitude: maps.longitude,
    },
    hasMap: maps.url,
    openingHoursSpecification: [
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: [
          'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday',
        ],
        opens: hours.pickupOpen,
        closes: hours.pickupClose,
      },
    ],
    areaServed: [
      { '@type': 'City', name: 'San José del Cabo' },
      { '@type': 'City', name: 'Cabo San Lucas' },
      { '@type': 'AdministrativeArea', name: 'Los Cabos' },
    ],
    knowsLanguage: ['en', 'es'],
    ...(socialLinks.length ? { sameAs: socialLinks.map((s) => s.href) } : {}),
  },
  {
    '@type': 'WebSite',
    '@id': `${site.origin}/#website`,
    url: `${site.origin}/`,
    name: site.name,
    inLanguage: 'en',
    publisher: { '@id': `${site.origin}/#business` },
  },
];

if (breadcrumb.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.origin}/` },
      ...breadcrumb.map((b, i) => ({
        '@type': 'ListItem',
        position: i + 2,
        name: b.name,
        item: new URL(b.href, site.origin).href,
      })),
    ],
  });
}

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(
  /</g,
  '\\u003c'
);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Only the display face is preloaded: it renders the LCP heading. Jost
         loads at normal priority so it does not compete on the critical path. -->
    <link rel="preload" href="/fonts/cormorant-latin-var.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <meta name="theme-color" content="#faf9f6" />
    <link rel="sitemap" href="/sitemap.xml" />

    <script type="application/ld+json" is:inline set:html={jsonLd} />
    <Analytics />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppFab message={fabMessage} location="floating" />
    <Reveal />
  </body>
</html>
