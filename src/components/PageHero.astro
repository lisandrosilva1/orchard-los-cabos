---
/** Interior-page opener: photograph behind, title over it. */
import Photo from './Photo.astro';
import type { ImageMetadata } from 'astro';

interface Props { src: ImageMetadata; alt: string; eyebrow: string; title: string; lead: string; }
const { src, alt, eyebrow, title, lead } = Astro.props;
---
<section class="phero">
  <div class="phero__fig">
    <Photo src={src} alt={alt} sizes="100vw" widths={[720, 1100, 1600, 2200]} priority />
  </div>
  <div class="phero__scrim" aria-hidden="true"></div>
  <div class="phero__in shell">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    <p class="lead phero__lead">{lead}</p>
    <slot />
  </div>
</section>

<style>
  .phero { position: relative; display: grid; align-items: end; min-height: clamp(30rem, 74vh, 44rem); isolation: isolate; overflow: hidden; }
  .phero__fig { position: absolute; inset: 0; z-index: -2; }
  .phero__fig :global(img), .phero__fig :global(picture) { width: 100%; height: 100%; object-fit: cover; }
  .phero__scrim {
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(to top, rgba(14,18,14,0.92) 0%, rgba(14,18,14,0.6) 40%, rgba(14,18,14,0.22) 74%, rgba(14,18,14,0.45) 100%);
  }
  .phero__in { padding-block: clamp(2.5rem, 5vw, 4.5rem); width: 100%; }
  .phero h1 { font-size: var(--t-h1); max-width: 16ch; }
  .phero__lead { margin-top: 1.6rem; }
</style>
