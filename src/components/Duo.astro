---
/** Offset image + copy. The image runs taller than the text column on desktop. */
import Photo from './Photo.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  flip?: boolean;
  ratio?: string;
  priority?: boolean;
  tone?: 'dark' | 'light';
}
const { src, alt, flip = false, ratio = '4/5', priority = false, tone = 'dark' } = Astro.props;
---
<section class:list={['duo bay', flip && 'duo--flip', tone === 'light' && 'light']}>
  <div class="duo__in shell">
    <div class="duo__fig fig rise">
      <Photo src={src} alt={alt} sizes="(min-width: 900px) 48vw, 100vw"
             widths={[420, 640, 900, 1200]} ratio={ratio} priority={priority} />
    </div>
    <div class="duo__body rise"><slot /></div>
  </div>
</section>

<style>
  .duo__in { display: grid; gap: clamp(2rem, 1rem + 4.5vw, 4.5rem); align-items: center; }
  .duo__body :global(h2) { font-size: var(--t-h2); max-width: 15ch; }
  .duo__body :global(.prose) { margin-top: 1.75rem; }
  @media (min-width: 900px) {
    .duo__in { grid-template-columns: 1.05fr 1fr; }
    .duo--flip .duo__fig { order: 2; }
  }
</style>
