---
/**
 * GA4 + a delegated event layer.
 *
 * Every measurable CTA on the site carries `data-evt` (event name) and
 * optional `data-cta` / `data-service` / `data-product`. One listener reads
 * them, so no component ships its own analytics JS.
 *
 * If PUBLIC_GA4_ID is unset the gtag script is not loaded, but events are still
 * pushed to window.dataLayer so the layer stays testable before the property
 * exists. See docs/ANALYTICS.md.
 */
const gaId = import.meta.env.PUBLIC_GA4_ID ?? '';
/**
 * Meta (Facebook/Instagram) pixel. Public in the same way the GA4 ID is — it ships
 * in the page HTML — and inert until set. Orchard's own pixel: never share one
 * across brands, or two businesses' audiences end up in the same bucket.
 */
const pixelId = import.meta.env.PUBLIC_META_PIXEL_ID ?? '';
const isProd = import.meta.env.PROD;
/** Only this host may send hits, so previews and forks cannot pollute GA4. */
const analyticsHost = 'orchardcabo.com';

/**
 * Event name → Meta standard event.
 *
 * Meta optimises properly only for events it recognises by name, so each of ours is
 * reported under the standard name that means the same thing. An event absent here
 * is not sent to the pixel at all: instagram_click sends people away from the site
 * and is nobody's conversion.
 */
const metaEvents = {
  order_whatsapp_click: 'Lead',
  phone_click: 'Contact',
  email_click: 'Contact',
  directions_click: 'FindLocation',
  product_view: 'ViewContent',
};
---

{
  pixelId && (
    <script is:inline define:vars={{ pixelId, isProd, analyticsHost }}>
      {/* Meta's base snippet, verbatim apart from the injected ID: defines fbq,
          loads fbevents.js, records one PageView. Every other event is sent by
          track() below, so the pixel and GA4 can never drift apart.

          Gated on the same production host as GA4, and for a stronger reason: a
          stray GA4 hit is noise in a report, while a stray pixel hit lands in the
          audiences and conversion data an ad account spends money against. */}
      var onPixelHost =
        location.hostname === analyticsHost || location.hostname.endsWith('.' + analyticsHost);
      if (isProd && onPixelHost) {
        !(function (f, b, e, v, n, t, s) {
          if (f.fbq) return;
          n = f.fbq = function () {
            n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
          };
          if (!f._fbq) f._fbq = n;
          n.push = n;
          n.loaded = !0;
          n.version = '2.0';
          n.queue = [];
          t = b.createElement(e);
          t.async = !0;
          t.src = v;
          s = b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t, s);
        })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixelId);
        fbq('track', 'PageView');
      }
    </script>
  )
}

<script is:inline define:vars={{ gaId, isProd, analyticsHost, metaEvents }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() { window.dataLayer.push(arguments); }
  window.gtag = gtag;

  // The tag is loaded at runtime and only on the production hostname. The
  // review preview and any fork run the same bundle but stay out of the data.
  var onProdHost =
    location.hostname === analyticsHost || location.hostname.endsWith('.' + analyticsHost);
  var gaActive = Boolean(gaId) && isProd && onProdHost;

  if (gaActive) {
    gtag('js', new Date());
    // No config options: GA4 truncates IPs by default, and passing the old
    // anonymize_ip flag here just rides along as a junk parameter on every
    // event. send_page_view stays on — one page_view per load, no duplicates.
    gtag('config', gaId);

    // gtag.js is ~166 KB and its parse work competes with painting the hero.
    // Measured on this site: loading it eagerly pushed mobile LCP from 1.8s to
    // 4.1s, almost all of it render delay, and cost 20 Lighthouse points.
    //
    // Deferring the *script* costs no data. gtag('js'|'config'|'event') just
    // pushes onto window.dataLayer, and gtag.js drains that queue when it
    // arrives — so page_view and any click that happens in the meantime are
    // all still recorded, just sent a moment later.
    var tagLoaded = false;
    var loadTag = function () {
      if (tagLoaded) return;
      tagLoaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
      document.head.appendChild(s);
    };

    // Load on the FIRST of: any user gesture, or the browser going idle after
    // load. The gesture listeners are attached immediately and capture-first,
    // so a click starts the download before our own click handler has even
    // queued its event — which keeps the queue short. Without them, a measured
    // click sat in dataLayer for seven seconds waiting for the idle callback,
    // and anyone closing the tab in that window would not have been counted.
    ['pointerdown', 'touchstart', 'keydown', 'scroll'].forEach(function (evt) {
      window.addEventListener(evt, loadTag, { once: true, passive: true, capture: true });
    });

    var schedule = function () {
      if ('requestIdleCallback' in window) requestIdleCallback(loadTag, { timeout: 3000 });
      else setTimeout(loadTag, 1500);
    };
    if (document.readyState === 'complete') schedule();
    else window.addEventListener('load', schedule, { once: true });
  }

  /** Fire a business event. Always hits dataLayer; hits GA4 and the pixel when
   *  each is configured. One call, so the two platforms count the same thing. */
  function track(name, params) {
    var payload = Object.assign(
      {
        page_path: location.pathname,
        language: document.documentElement.lang || 'en',
      },
      params || {}
    );
    if (gaActive) gtag('event', name, payload);
    else window.dataLayer.push(Object.assign({ event: name }, payload));

    var metaName = metaEvents[name];
    if (metaName && typeof window.fbq === 'function') {
      window.fbq('track', metaName, {
        content_name: payload.product || payload.service || payload.cta_location,
      });
    }
    if (!isProd) console.info('[analytics]', name, payload);
  }
  window.orchardTrack = track;

  // ---- delegated CTA tracking -------------------------------------------
  document.addEventListener(
    'click',
    function (e) {
      var el = e.target instanceof Element ? e.target.closest('a,button') : null;
      if (!el) return;

      var params = {};
      if (el.dataset.cta) params.cta_location = el.dataset.cta;
      if (el.dataset.service) params.service = el.dataset.service;
      if (el.dataset.product) params.product = el.dataset.product;

      if (el.dataset.evt) { track(el.dataset.evt, params); return; }

      // Implicit events for contact links that carry no explicit data-evt.
      var href = el.getAttribute('href') || '';
      if (href.startsWith('tel:')) track('phone_click', params);
      else if (href.startsWith('mailto:')) track('email_click', params);
      else if (href.indexOf('wa.me') > -1) track('order_whatsapp_click', params);
      else if (href.indexOf('instagram.com') > -1) track('instagram_click', params);
      else if (href.indexOf('google.com/maps') > -1 || href.indexOf('maps.app.goo.gl') > -1)
        track('directions_click', params);
    },
    { passive: true }
  );

  // ---- product_view: fires once per product block when it is seen --------
  // This script runs in <head>, so wait for the DOM before querying for the
  // product blocks — otherwise the observer is attached to nothing.
  function observeProducts() {
    if (!('IntersectionObserver' in window)) return;
    var seen = new WeakSet();
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting || seen.has(entry.target)) return;
          seen.add(entry.target);
          track('product_view', { product: entry.target.dataset.product });
          io.unobserve(entry.target);
        });
      },
      { threshold: 0.5 }
    );
    document.querySelectorAll('[data-product-view]').forEach(function (n) { io.observe(n); });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', observeProducts);
  } else {
    observeProducts();
  }
</script>

{
  pixelId && (
    <noscript>
      {/* The no-JavaScript fallback Meta asks for. It is a plain image request,
          so it fires wherever the page is served — unlike the script above, which
          is host-gated. Harmless: a PageView is not a conversion. */}
      <img
        height="1"
        width="1"
        style="display:none"
        alt=""
        src={`https://www.facebook.com/tr?id=${pixelId}&ev=PageView&noscript=1`}
      />
    </noscript>
  )
}
