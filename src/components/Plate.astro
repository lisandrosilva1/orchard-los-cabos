---
/** Full-bleed photograph with a statement laid over it. */
import Photo from './Photo.astro';
import type { ImageMetadata } from 'astro';

interface Props { src: ImageMetadata; alt: string; height?: string; }
const { src, alt, height = 'clamp(30rem, 78vh, 46rem)' } = Astro.props;
---
<section class="plate" style={`--plate-h:${height}`}>
  <div class="plate__fig">
    <Photo src={src} alt={alt} sizes="100vw" widths={[720, 1100, 1600, 2200]} />
  </div>
  <div class="plate__scrim" aria-hidden="true"></div>
  <div class="plate__in shell rise"><slot /></div>
</section>

<style>
  .plate { position: relative; min-height: var(--plate-h); display: grid; align-items: end; isolation: isolate; overflow: hidden; }
  .plate__fig { position: absolute; inset: 0; z-index: -2; }
  .plate__fig :global(img), .plate__fig :global(picture) { width: 100%; height: 100%; object-fit: cover; }
  .plate__scrim {
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(to top, rgba(14,18,14,0.88) 0%, rgba(14,18,14,0.5) 38%, rgba(14,18,14,0.14) 72%, rgba(14,18,14,0.28) 100%);
  }
  .plate__in { padding-block: clamp(3rem, 6vw, 5.5rem); width: 100%; }
  .plate__in :global(.statement) { max-width: 18ch; }
</style>
