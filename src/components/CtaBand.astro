---
import { whatsappUrl, contact } from '../data/site';
interface Props { location: string; }
const { location: loc } = Astro.props;
const order = whatsappUrl("Hi Orchard — I'd like to order farm products. What's available this week?");
const visit = whatsappUrl("Hi Orchard — I'd like to book a farm visit. Could you share dates and details?");
const work = whatsappUrl('Hi Orchard — I run a hospitality business in Los Cabos and would like to discuss regular supply.');
---
<section class="cta bay">
  <div class="shell cta__in rise">
    <span class="eyebrow">Fresh from Orchard</span>
    <p class="statement cta__h">Order, visit, or put us on your menu.</p>
    <p class="lead cta__lead">WhatsApp reaches the farm fastest — we answer there first.</p>

    <div class="btns cta__btns">
      <a class="btn btn--solid" href={order} target="_blank" rel="noopener"
         data-evt="order_whatsapp_click" data-cta={`cta_band_${loc}`}>Order</a>
      <a class="btn btn--line" href={visit} target="_blank" rel="noopener"
         data-evt="farm_visit_click" data-cta={`cta_band_${loc}`}>Visit</a>
      <a class="btn btn--line" href={work} target="_blank" rel="noopener"
         data-evt="hospitality_inquiry" data-cta={`cta_band_${loc}`}>Work with us</a>
    </div>

    <p class="cta__alt">
      <a href={`tel:${contact.phoneE164}`} data-cta={`cta_band_${loc}`}>{contact.phoneDisplay}</a>
      <span aria-hidden="true">&nbsp;&nbsp;/&nbsp;&nbsp;</span>
      <a href={`mailto:${contact.email}`} data-cta={`cta_band_${loc}`}>{contact.email}</a>
    </p>
  </div>
</section>

<style>
  .cta { background: var(--night-2); border-top: 1px solid var(--line-d-soft); text-align: center; }
  .cta__in { display: grid; justify-items: center; }
  .cta__h { font-size: var(--t-h2); max-width: 17ch; }
  .cta__lead { margin-top: 1.35rem; text-align: center; }
  .cta__btns { justify-content: center; }
  .cta__alt { margin-top: 2.5rem; font-size: var(--t-small); color: var(--on-dark-mute); }
  .cta__alt a { text-decoration: none; border-bottom: 1px solid var(--line-d); padding-bottom: 2px; }
  .cta__alt a:hover { border-color: var(--ember); color: var(--on-dark); }
</style>
