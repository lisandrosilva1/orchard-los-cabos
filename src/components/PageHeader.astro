---
interface Props { eyebrow: string; title: string; lead: string; }
const { eyebrow, title, lead } = Astro.props;
---
<section class="ph">
  <div class="wrap">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    <p class="lead ph__lead">{lead}</p>
    <slot />
  </div>
</section>
<hr class="rule" />

<style>
  .ph { padding-block: clamp(2.75rem, 1.8rem + 4vw, 5.5rem) clamp(2.5rem, 1.8rem + 3vw, 4.5rem); }
  .ph h1 { font-size: var(--t-h1); max-width: 17ch; }
  .ph__lead { margin-top: 1.5rem; }
</style>
