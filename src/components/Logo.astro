---
/** Wordmark: Cormorant caps over wide-tracked Jost, split by a hairline. */
interface Props { size?: 'sm' | 'md'; }
const { size = 'md' } = Astro.props;
---
<span class:list={['mark', `mark--${size}`]}>
  <span class="mark__name">Orchard</span>
  <span class="mark__rule" aria-hidden="true"></span>
  <span class="mark__place">Los Cabos</span>
</span>

<style>
  .mark { display: inline-grid; justify-items: center; gap: 0.34rem; line-height: 1; }
  .mark__name {
    font-family: var(--display);
    font-weight: 300;
    font-size: 1.75rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    padding-left: 0.09em;
  }
  .mark__rule { width: 100%; height: 1px; background: currentColor; opacity: 0.4; }
  .mark__place {
    font-family: var(--ui);
    font-weight: 400;
    font-size: 0.5rem;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    padding-left: 0.42em;
    opacity: 0.78;
  }
  .mark--sm .mark__name { font-size: 1.4rem; }
  .mark--sm .mark__place { font-size: 0.45rem; }
  @media (min-width: 900px) { .mark--md .mark__name { font-size: 2rem; } }
</style>
